//@version=5
indicator("Holt-Winters Channel", "HWC", overlay=true)
period = input.int(20, minval=1)
multiplier = input.float(1.0, minval=0.0)
alpha = 2.0 / (period + 1.0)
beta = 1.0 / period
gamma = 1.0 / period
var float level = na
var float trend = 0.0
var float acceleration = 0.0
var float error = 0.0
forecast = nz(level) + trend + 0.5 * acceleration
newLevel = na(level) ? close : alpha * close + (1.0 - alpha) * forecast
newTrend = beta * (newLevel - nz(level)) + (1.0 - beta) * (trend + acceleration)
newAcceleration = gamma * (newTrend - trend) + (1.0 - gamma) * acceleration
error := na(level) ? 0.0 : alpha * math.pow(close - forecast, 2) + (1.0 - alpha) * error
level := newLevel
trend := newTrend
acceleration := newAcceleration
middle = level + trend + 0.5 * acceleration
band = multiplier * math.sqrt(error)
plot(middle, "Middle", color=color.blue)
plot(middle + band, "Upper", color=color.green)
plot(middle - band, "Lower", color=color.red)