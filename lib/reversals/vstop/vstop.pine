//@version=5
indicator("Volatility Stop", "VSTOP", overlay=true)
period = input.int(20, minval=1)
multiplier = input.float(2.0, minval=0.0)
atr = ta.atr(period)
var float stop = na
var bool rising = true
candidate = rising ? close - multiplier * atr : close + multiplier * atr
stop := rising ? math.max(nz(stop, candidate), candidate) : math.min(nz(stop, candidate), candidate)
if rising and close < stop
    rising := false
    stop := close + multiplier * atr
if not rising and close > stop
    rising := true
    stop := close - multiplier * atr
plot(stop, "Stop", color=rising ? color.green : color.red, linewidth=2)